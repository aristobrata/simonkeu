{
    "name": "pusdiklat/simonkeu",
    "description": "SIMONKEU - Sistem Monitoring Keuangan Pusdiklat (CodeIgniter 4 + MySQL)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
